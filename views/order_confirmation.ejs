<%- include('partials/header') %>

<section class="hero">
  <span class="eyebrow">Order placed</span>
  <div class="confirmation-card">
    <div class="checkmark">✓</div>
    <h1>Order Confirmed</h1>
    <p>
      You ordered: <strong><%= order.item_name %></strong> × <%= order.quantity %>
      — Nu. <%= (order.price_at_order * order.quantity).toFixed(2) %>
    </p>
    <form method="POST" action="/orders/<%= order.id %>/update" class="quantity-form">
      <label for="quantity">Quantity</label>
      <input type="number" id="quantity" name="quantity" min="1" value="<%= order.quantity %>">
      <button type="submit" class="btn btn-secondary">Update</button>
    </form>
    <form method="POST" action="/orders/<%= order.id %>/cancel">
      <button type="submit" class="btn btn-danger">Cancel Order</button>
    </form>

    <a href="/" class="btn">Back to Home</a>


  </div>
</section>

<%- include('partials/footer') %>

